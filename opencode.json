{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Sentry": {
      "command": [
        "/Applications/Automatic.app/Contents/MacOS/automatic",
        "mcp-proxy",
        "Sentry"
      ],
      "type": "local"
    },
    "automatic": {
      "command": [
        "/Applications/Automatic.app/Contents/MacOS/automatic",
        "mcp-serve"
      ],
      "environment": {
        "AUTOMATIC_PROJECT": "bounce"
      },
      "type": "local"
    },
    "nightowl": {
      "type": "remote",
      "url": "http://127.0.0.1:7300/mcp"
    }
  }
}