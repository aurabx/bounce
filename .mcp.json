{
  "mcpServers": {
    "Sentry": {
      "args": [
        "mcp-proxy",
        "Sentry"
      ],
      "command": "/Applications/Automatic.app/Contents/MacOS/automatic"
    },
    "automatic": {
      "args": [
        "mcp-serve"
      ],
      "command": "/Applications/Automatic.app/Contents/MacOS/automatic",
      "env": {
        "AUTOMATIC_PROJECT": "bounce"
      }
    }
  }
}